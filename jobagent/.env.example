# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=
MAIL_WEBHOOK_SECRET=change-me-long-random
ENCRYPTION_KEY=              # python scripts/gen_key.py
PROXY_URL=                   # optional, e.g. http://user:pass@host:port (Playwright + crawlers)

# Where verification mail lands: client{id}@APPLY_DOMAIN
APPLY_DOMAIN=apply.example.com
OPERATOR_EMAIL=you@example.com
BASE_URL=http://localhost:8000
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

DATABASE_URL=sqlite:///data/jobagent.db   # or postgresql+psycopg://user:pass@host/db
REDIS_URL=                                # empty -> DB-backed queue

# LLM: auto = live when ANTHROPIC_API_KEY is set, else deterministic mock
LLM_MODE=auto
HAIKU_MODEL=claude-haiku-4-5
SONNET_MODEL=claude-sonnet-5

# Outbound mail: log | mailgun | smtp
MAIL_PROVIDER=log
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=JobAgent <noreply@apply.example.com>

HEADLESS=true
