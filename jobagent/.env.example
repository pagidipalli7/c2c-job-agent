# Copy to .env and fill in. Never commit .env. Keep comments on their own lines.

# --- secrets ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# any long random string; also the Mailgun webhook signing key if you use Mailgun inbound
MAIL_WEBHOOK_SECRET=change-me-long-random
# generate with: python scripts/gen_key.py
ENCRYPTION_KEY=
# optional proxy for Playwright + crawlers, e.g. http://user:pass@host:port
PROXY_URL=

# --- identity ----------------------------------------------------------------
# verification mail lands at client{id}@APPLY_DOMAIN
APPLY_DOMAIN=apply.example.com
OPERATOR_EMAIL=you@example.com
BASE_URL=http://localhost:8000
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- infrastructure ----------------------------------------------------------
# sqlite by default; postgresql+psycopg://user:pass@host/db later
DATABASE_URL=sqlite:///data/jobagent.db
# leave empty for the DB-backed queue; redis://localhost:6379/0 to use Redis
REDIS_URL=

# --- LLM: auto = live when ANTHROPIC_API_KEY is set, else deterministic mock ----
LLM_MODE=auto
HAIKU_MODEL=claude-haiku-4-5
SONNET_MODEL=claude-sonnet-5

# --- outbound mail: log | mailgun | smtp ------------------------------------
MAIL_PROVIDER=log
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=JobAgent <noreply@apply.example.com>

# --- discovery: Workday tenants are searched once per term (comma-separated) ----
WORKDAY_SEARCH_TERMS=Power Platform,Power Apps,Power Automate,Dynamics 365,Power BI,Dataverse,Data Engineer,Databricks

# --- browser -----------------------------------------------------------------
HEADLESS=true
# optional: a specific Chromium binary instead of the Playwright-managed one
CHROMIUM_EXECUTABLE=
